{
    "name": "personal/finances",
    "description": "Personal finances app using Laravel components",
    "require": {
        "php": ">=8.0",
        "illuminate/database": "^10.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
        "post-root-package-install": "Illuminate\\Foundation\\ComposerScripts::postRootPackageInstall",
        "post-create-project-cmd": "Illuminate\\Foundation\\ComposerScripts::postCreateProject"
    }
}
